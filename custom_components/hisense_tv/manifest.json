{
  "domain": "hisense_tv",
  "name": "Hisense TV",
  "codeowners": ["@V4n1X"],
  "config_flow": true,
  "dhcp": [
    {"registered_devices": true}
  ],
  "documentation": "https://github.com/V4n1X/ha_hisensetv",
  "integration_type": "device",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/V4n1X/ha_hisensetv/issues",
  "loggers": ["aiomqtt"],
  "quality_scale": "bronze",
  "requirements": ["aiomqtt>=2.0.0,<3.0.0"],
  "ssdp": [
    {
      "st": "urn:schemas-upnp-org:service:HisenseLanControl:1"
    },
    {
      "nt": "urn:schemas-upnp-org:service:HisenseLanControl:1"
    },
    {
      "modelDescription": "*mqttport*"
    },
    {
      "modelDescription": "*transport_protocol*"
    },
    {
      "manufacturerURL": "*hisense.com*"
    },
    {
      "st": "urn:schemas-upnp-org:device:MediaRenderer:1",
      "manufacturer": "hisense*"
    },
    {
      "st": "urn:schemas-upnp-org:device:MediaRenderer:1",
      "manufacturer": "vidaa*"
    },
    {
      "st": "urn:schemas-upnp-org:device:MediaRenderer:1",
      "manufacturer": "Hisense*"
    },
    {
      "st": "urn:schemas-upnp-org:device:MediaRenderer:1",
      "manufacturer": "VIDAA*"
    }
  ],
  "version": "1.3.0"
}
